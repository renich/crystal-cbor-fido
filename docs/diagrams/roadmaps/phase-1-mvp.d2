direction: right

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 4
    pad: 40
  }
}

classes: {
  milestone: {
    style: {
      stroke: "#2F855A"
      stroke-width: 2
      border-radius: 8
      fill: "#F0FFF4"
    }
  }
  task_node: {
    shape: rectangle
    style: {
      stroke: "#2F855A"
      stroke-width: 2
      border-radius: 6
      fill: "#C6F6D5"
      font-color: "#22543D"
    }
  }
}

m1_1: "Milestone 1.1: Core Canonical CBOR Runtime" {
  class: milestone

  t101: "TASK-101 (Task 1.1): Value Union & Exception Hierarchy\nFulfills: [FUNC-005], [TECH-001], [TECH-004], [TECH-005]\nBlocked By: None | Unblocks: TASK-102, TASK-103\nStatus: Completed" {
    class: task_node
  }

  t102: "TASK-102 (Task 1.2): IEEE 754 Float16 Narrowing Engine\nFulfills: [FUNC-003], [TECH-002], [TECH-005]\nBlocked By: TASK-101 | Unblocks: TASK-104\nStatus: Completed" {
    class: task_node
  }

  t103: "TASK-103 (Task 1.3): Canonical Encoder & Map Key Sorter\nFulfills: [FUNC-001], [FUNC-002], [TECH-001], [TECH-005]\nBlocked By: TASK-101 | Unblocks: TASK-104\nStatus: Completed" {
    class: task_node
  }

  t101 -> t102: "Unblocks"
  t101 -> t103: "Unblocks"
}

m1_2: "Milestone 1.2: Hardening & Quality Verification" {
  class: milestone

  t104: "TASK-104 (Task 1.4): Strict Canonical Decoder & Bounds Guard\nFulfills: [FUNC-004], [TECH-003], [TECH-005]\nBlocked By: TASK-102, TASK-103 | Unblocks: TASK-105\nStatus: Completed" {
    class: task_node
  }

  t105: "TASK-105 (Task 1.5): Adversarial Specs, SAST & Docs Portal\nFulfills: [FUNC-005], [TECH-004], [TECH-005]\nBlocked By: TASK-104 | Unblocks: TASK-201\nStatus: Completed" {
    class: task_node
  }

  t104 -> t105: "Unblocks"
}

m1_1.t102 -> m1_2.t104: "Critical Path"
m1_1.t103 -> m1_2.t104: "Critical Path"
